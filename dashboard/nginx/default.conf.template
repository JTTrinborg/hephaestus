# Rendered by the nginx image at start, only ${FASTAPI_KEY} is replaced.
# The key stays in this server config and never reaches the browser.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header X-API-Key "${FASTAPI_KEY}";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Hashed assets never change, so they can be cached for long
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every other path is a page in the app
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
