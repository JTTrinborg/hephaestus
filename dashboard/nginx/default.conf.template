# Rendered by the nginx image at start, only ${FASTAPI_KEY} is replaced.
# The key stays in this server config and never reaches the browser.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's DNS. With the address in a variable, nginx looks up api again
    # when the api container is rebuilt and gets a new IP, instead of answering 502
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header X-API-Key "${FASTAPI_KEY}";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Hashed assets never change, so they can be cached for long
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every other path is a page in the app
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
